# Public target values only. Copy values into your shell or GitHub environment variables.
# The scripts do not automatically load this file.
MBN_SUPABASE_PROJECT_REF=
MBN_SUPABASE_PUBLISHABLE_KEY=
MBN_PUBLIC_ORIGIN=
NETLIFY_SITE_ID=
# Deployment stays disabled unless explicitly configured.
MBN_DEPLOY_ENABLED=false
# Leave false for an existing database. See the installation guide for first-install recovery.
MBN_INITIALIZE_CATALOG=false
# Privileged values belong in GitHub environment secrets or the local process environment.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
NETLIFY_AUTH_TOKEN=
